<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="XmlExtensions.PatchOperationEditString">
    <xpath>Defs/ThingDef[defName='Steel']/label</xpath>
    <replaceWith>scrap metal</replaceWith>
  </Operation>
  <Operation Class="XmlExtensions.PatchOperationEditString">
    <xpath>Defs/ThingDef[defName='Steel']/description</xpath>
    <replaceWith>Salvaged wreck metal used for building a huge variety of structures, weapons, and machines.</replaceWith>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName='Steel']/stuffProps</xpath>
    <value>
      <stuffAdjective>metal</stuffAdjective>
    </value>
  </Operation>

  <Operation Class="XmlExtensions.PatchOperationEditString">
    <xpath>Defs/ThingDef[defName='MineableSteel']/label</xpath>
    <replaceWith>compacted scrap</replaceWith>
  </Operation>
  <Operation Class="XmlExtensions.PatchOperationEditString">
    <xpath>Defs/ThingDef[defName='MineableSteel']/description</xpath>
    <replaceWith>The remains of some collapsed pre-war structure. Rich in scrap metal.</replaceWith>
  </Operation>
</Patch>
