    <xpath>Defs/ThingDef[defName='AncientRazorWire']</xpath>
    <value>
      <costList>
        <Steel>4</Steel>
      </costList>
      <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    </value>
  </Operation>

